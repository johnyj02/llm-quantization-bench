.claude/settings.local.json
__pycache__/
.venv/
venv-quant/
venv-serve/
*.pyc
.DS_Store
outputs/
results/

# ---- secrets: never commit ----
.env
.env.*
*.token
*.pem
hf_token*

# ---- paper build products (Overleaf git remote holds the source) ----
paper/*.aux
paper/*.log
paper/*.out
paper/*.bbl
paper/*.blg
paper/*.synctex.gz
paper/*.fdb_latexmk
paper/*.fls

# Machine-local box identity. Keeps resource names STABLE across box_up.sh
# re-runs so it stays idempotent; delete to start a genuinely new box.
.box-run-id

# Keep the compressed archive local; publish its extracted contents.
/artifacts/release/*.tar.xz
/artifacts/release/*.tar.xz.sha256

# Local documentation and planning files
/CLAUDE.md
/ieee/
/paper/
/ask-planner
/ask-reviewer
