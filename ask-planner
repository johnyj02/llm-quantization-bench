#!/usr/bin/env bash
# Ask the Planner session a question and print its answer.
#
#   ./ask-planner "what should I do next?"
#
# Resumes the Planner conversation, so it remembers everything it has been
# asked. Set FORK=1 to read its context without writing to its history.
# Override MODEL or EFFORT to change what answers the question.

set -euo pipefail

PLANNER_SESSION="54ba15b1-f000-4106-a851-05e8a2693e49"
EFFORT="${EFFORT:-max}"          # highest of: low medium high xhigh max
# Opus 5 with the 1M-token context window. Verified via --debug-file that this
# reaches the wire intact as model=global.anthropic.claude-opus-5[1m], and that
# it survives --resume. Note the session transcript records it as plain
# "claude-opus-5" regardless, so don't use the log to check which model ran.
MODEL="${MODEL:-global.anthropic.claude-opus-5[1m]}"

if [ $# -eq 0 ]; then
  echo "usage: ./ask-planner \"<question>\"" >&2
  exit 1
fi

RESUME_ARGS=(--resume "$PLANNER_SESSION")
[ "${FORK:-0}" = "1" ] && RESUME_ARGS+=(--fork-session)

[ -n "$MODEL" ] && RESUME_ARGS+=(--model "$MODEL")

claude "${RESUME_ARGS[@]}" \
  --effort "$EFFORT" \
  -p "$*" \
  --output-format json | jq -r '.result'
